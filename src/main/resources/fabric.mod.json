{
  "schemaVersion": 1,
  "id": "simplebedrockmodel",
  "version": "${version}",
  "name": "SimpleBedrockModel",
  "description": "A library for loading Minecraft Bedrock Edition entity models and animation",
  "authors": [
    "TartaricAcid",
    "MaydayMemory",
    "MoePus",
    "Hidomatn",
    "xjqsh"
  ],
  "license": "LGPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.mcmodderanchor.simplebedrockmodel.SimpleBedrockModel"
    ],
    "client": [
      "com.github.mcmodderanchor.simplebedrockmodel.SimpleBedrockModelClient"
    ]
  },
  "mixins": [
    "simplebedrockmodel.mixins.json"
  ],
  "accessWidener": "simplebedrockmodel.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "sodium": "*",
    "epicfight": "*"
  }
}
